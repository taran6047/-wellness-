# Скопируйте в .env и подставьте свои значения
DATABASE_URL="postgresql://postgres:password@localhost:5432/family_wellness?schema=public"

# Сгенерируйте командой: npx auth secret (или openssl rand -base64 32)
AUTH_SECRET="replace-with-random-secret"

# Нужен только в продакшене (адрес вашего домена); локально не задавайте — раскомментируйте при публикации
# AUTH_URL="https://your-domain.example"
